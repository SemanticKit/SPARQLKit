@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix sk: <https://codex.local/sparqlkit/conformance#> .

<https://example.org/manifests/smoke> a mf:Manifest ;
   mf:name "SPARQLKit smoke conformance" ;
   mf:entries (
     <#json-bindings-basic>
     <#json-boolean-basic>
     <#xml-bindings-basic>
     <#tsv-bindings-basic>
     <#render-basic-select>
   ) .

<#json-bindings-basic>
   a sk:DecodeJSONBindingsTest ;
   mf:result <select_result.json> ;
   sk:expectVariableCount "2" ;
   sk:expectBindingCount "3" .

<#json-boolean-basic>
   a sk:DecodeJSONBooleanTest ;
   mf:result <ask_result_true.json> ;
   sk:expectBoolean "true" .

<#xml-bindings-basic>
   a sk:DecodeXMLBindingsTest ;
   mf:result <select_result_xml.xml> ;
   sk:expectVariableCount "2" ;
   sk:expectBindingCount "2" .

<#tsv-bindings-basic>
   a sk:DecodeTSVBindingsTest ;
   mf:result <select_result_tsv.tsv> ;
   sk:expectVariableCount "2" ;
   sk:expectBindingCount "3" .

<#render-basic-select>
   a sk:RenderQueryTest ;
   sk:queryTemplate [ a sk:BasicSelectQuery ] ;
   sk:expectContains "SELECT ?s ?o" , "LIMIT 5" , "WHERE {" .
