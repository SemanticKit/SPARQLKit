# A query dataset whose graph IRIs hold characters the protocol parameters
# percent-encode: '?', '=' and '&' (default graph) and '#' (named graph).
@prefix sd: <http://www.w3.org/ns/sparql-service-description#> .

[] a sd:Dataset ;
  sd:defaultGraph <https://example.org/g?x=1&y=2> ;
  sd:namedGraph [ sd:name <https://example.org/named#frag> ] .
