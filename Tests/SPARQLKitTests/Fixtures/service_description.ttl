@prefix sd: <http://www.w3.org/ns/sparql-service-description#> .
@prefix formats: <http://www.w3.org/ns/formats/> .

<https://example.org/sparql> a sd:Service ;
  sd:endpoint <https://example.org/sparql> ;
  sd:supportedLanguage sd:SPARQL12Query ;
  sd:feature sd:UnionDefaultGraph ;
  sd:resultFormat formats:SPARQL_Results_JSON ;
  sd:resultFormat formats:Turtle ;
  sd:defaultEntailmentRegime <http://www.w3.org/ns/entailment/RDFS> .
